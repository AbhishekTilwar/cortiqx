# Copy to .env and fill from Firebase Console → Project settings → Your apps (Web).
# https://console.firebase.google.com/

# Canonical origin for SEO (Open Graph, JSON-LD, sitemap URLs). No trailing slash.
# VITE_SITE_URL=https://cortiqx.in

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firestore: forced long-polling reduces QUIC/WebChannel issues in Chrome (default: on).
# Set to false or 0 to use default transport (slightly higher throughput on stable networks).
# VITE_FIRESTORE_LONG_POLLING=false

# Optional: absolute URL if send-mail is not same-origin /api/sendMail
# VITE_SEND_MAIL_URL=https://your-domain.com/api/sendMail

# Optional: override consultation mail API (default same-origin /api/sendConsultation on Vercel)
# VITE_CONSULTATION_API_URL=https://your-domain.com/api/sendConsultation

# --- Server only (Vercel → Environment Variables). Do not prefix these with VITE_. ---
# SMTP is edited in the admin panel and stored in Firestore (settings/mail).
# The mail API reads that document with a Firebase service account
# (Firebase Console → Project settings → Service accounts → Generate new private key).
# Paste the JSON on one line, or base64-encode it:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com"}
# Local dev can instead use the downloaded key file in the project root
# (any *firebase-adminsdk*.json, which is gitignored), or point at it:
# GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json
#
# Or set the fields separately (keep \n inside the private key):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
#
# Optional fallback, used only when the admin panel has not saved SMTP:
# CONSULTATION_NOTIFY_EMAIL=you@yourdomain.com
# MAIL_FROM="CortiqX <hello@yourdomain.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=hello@yourdomain.com
# SMTP_PASS=your-app-password
